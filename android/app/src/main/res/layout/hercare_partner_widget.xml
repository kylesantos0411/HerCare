<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/partner_widget_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hercare_partner_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/partner_widget_header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hercare_partner_widget_action_primary"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="@string/partner_widget_kicker"
                android:textAllCaps="true"
                android:textColor="@color/partner_widget_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/partner_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/partner_widget_title_default"
                android:textColor="@color/partner_widget_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/partner_widget_updated_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/partner_widget_updated_default"
                android:textColor="@color/partner_widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/partner_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hercare_partner_widget_metric_chip"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:text="@string/partner_widget_status_default"
            android:textAllCaps="true"
            android:textColor="@color/partner_widget_label"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/partner_widget_metric_hydration_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/hercare_partner_widget_metric_chip"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/partner_widget_metric_hydration"
                android:textAllCaps="true"
                android:textColor="@color/partner_widget_label"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/partner_widget_hydration_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="--"
                android:textColor="@color/partner_widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/partner_widget_metric_meals_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/hercare_partner_widget_metric_chip"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/partner_widget_metric_meals"
                android:textAllCaps="true"
                android:textColor="@color/partner_widget_label"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/partner_widget_meals_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="--"
                android:textColor="@color/partner_widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/partner_widget_study_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/hercare_partner_widget_metric_chip"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/partner_widget_study_title"
            android:textAllCaps="true"
            android:textColor="@color/partner_widget_label"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/partner_widget_study_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="No live study sync yet."
            android:textColor="@color/partner_widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/partner_widget_note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/hercare_partner_widget_metric_chip"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/partner_widget_note_title"
            android:textAllCaps="true"
            android:textColor="@color/partner_widget_label"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/partner_widget_note_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Open Partner View to connect this phone and see shared care updates."
            android:textColor="@color/partner_widget_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/partner_widget_action_board"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/hercare_partner_widget_action_primary"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/partner_widget_action_board"
            android:textColor="@color/partner_widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/partner_widget_action_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/hercare_partner_widget_action_secondary"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/partner_widget_action_settings"
            android:textColor="@color/partner_widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
